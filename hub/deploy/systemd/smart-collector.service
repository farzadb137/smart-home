[Unit]
Description=Smart Hub - MQTT Collector
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=farzad
Group=farzad
EnvironmentFile=/etc/smart-hub/secrets.env
WorkingDirectory=/home/farzad/smart-hub/hub/backend/src/hub
ExecStart=/home/farzad/smart-hub/.venv/bin/python3 /home/farzad/smart-hub/hub/backend/src/hub/mqtt_collector.py

Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=smart.target