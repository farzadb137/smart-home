[Unit]
Description=IoT Hub - DB maintenance (rollup, prune, vacuum)
After=iot-collector.service

[Service]
Type=oneshot
User=farzad
Group=farzad
WorkingDirectory=/home/farzad/iot/collector
ExecStart=/home/farzad/iot/collector/.venv/bin/python3 /home/farzad/iot/collector/hub_maintenance.py

NoNewPrivileges=yes
PrivateTmp=yes