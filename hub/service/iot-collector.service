[Unit]
Description=IoT Hub - MQTT Collector
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=farzad
Group=farzad
EnvironmentFile=/etc/iot/secrets.env
WorkingDirectory=/home/farzad/iot/collector
ExecStart=/home/farzad/iot/collector/.venv/bin/python3 /home/farzad/iot/collector/mqtt_collector.py

Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=iot.target