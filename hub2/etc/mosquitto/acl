# Each device may only publish to its own telemetry/status topics
# and subscribe to its own command topic.
pattern write home/devices/%u/telemetry
pattern write home/devices/%u/status
pattern write home/devices/%u/response
pattern read  home/devices/%u/command

# All devices also read the hub's broadcast time - not device-scoped,
# so every device (and every other user) gets the same literal topic
# rather than a %u substitution.
pattern read  home/time

# The hub's collector reads all telemetry/status and broadcasts wall-
# clock time. It still never writes to a device's own command topic -
# that boundary stays with hub_commander below.
user hub_collector
topic read home/devices/+/telemetry
topic read home/devices/+/status
topic read home/devices/+/children/+/telemetry
topic read home/devices/+/children/+/status
topic write home/time

# The hub's command sender (used by your API later) publishes commands, reads responses
user hub_commander
topic write home/devices/+/command
topic read  home/devices/+/response
topic write home/devices/+/children/+/command
topic read  home/devices/+/children/+/response